<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA FORMULARIO — Dashboard Gerencial (RF-18, RF-20)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_dashboard_form" model="ir.ui.view">
        <field name="name">ts.dashboard.form</field>
        <field name="model">ts.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard TechStore" create="false" edit="false">
                <header>
                    <button name="action_refresh"
                            string="Actualizar Dashboard"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_report"
                            string="Exportar Reporte PDF"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <h2 class="text-center mb-3">Dashboard de Gestión — TechStore Maintenance</h2>

                    <!-- ── Resumen general (4 tarjetas) ── -->
                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                        <div style="flex: 1 1 calc(25% - 12px); min-width: 140px;"
                             class="border rounded p-3 text-center bg-light">
                            <div class="font-weight-bold" style="font-size: 24px; color: #343a40;">
                                <field name="total_orders" readonly="1"/>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 13px;">Total de Órdenes</div>
                        </div>
                        <div style="flex: 1 1 calc(25% - 12px); min-width: 140px;"
                             class="border rounded p-3 text-center bg-light">
                            <div class="font-weight-bold" style="font-size: 24px; color: #007bff;">
                                <field name="count_active" readonly="1"/>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 13px;">Órdenes Activas</div>
                        </div>
                        <div style="flex: 1 1 calc(25% - 12px); min-width: 140px;"
                             class="border rounded p-3 text-center bg-light">
                            <div class="font-weight-bold" style="font-size: 24px; color: #28a745;">
                                <field name="count_delivered" readonly="1"/>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 13px;">Entregadas</div>
                        </div>
                        <div style="flex: 1 1 calc(25% - 12px); min-width: 140px;"
                             class="border rounded p-3 text-center bg-light">
                            <div class="font-weight-bold" style="font-size: 24px; color: #6c757d;">
                                <field name="count_closed" readonly="1"/>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 13px;">Cerradas</div>
                        </div>
                    </div>

                    <!-- ── Desglose por estado (6 tarjetas) ── -->
                    <h4 class="mb-2">Estado de Órdenes</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;">
                        <div style="flex: 1 1 calc(16.66% - 10px); min-width: 130px;"
                             class="border rounded p-2 text-center bg-light">
                            <div class="font-weight-bold" style="font-size: 20px; color: #007bff;">
                                <field name="count_received" readonly="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">Recibidas</div>
                        </div>
                        <div style="flex: 1 1 calc(16.66% - 10px); min-width: 130px; background: #fff3cd;"
                             class="border rounded p-2 text-center">
                            <div class="font-weight-bold" style="font-size: 20px; color: #e0a800;">
                                <field name="count_diagnosis" readonly="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">En Diagnóstico</div>
                        </div>
                        <div style="flex: 1 1 calc(16.66% - 10px); min-width: 130px; background: #cce5ff;"
                             class="border rounded p-2 text-center">
                            <div class="font-weight-bold" style="font-size: 20px; color: #17a2b8;">
                                <field name="count_repair" readonly="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">En Reparación</div>
                        </div>
                        <div style="flex: 1 1 calc(16.66% - 10px); min-width: 130px; background: #d4edda;"
                             class="border rounded p-2 text-center">
                            <div class="font-weight-bold" style="font-size: 20px; color: #28a745;">
                                <field name="count_ready" readonly="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">Listas Entrega</div>
                        </div>
                        <div style="flex: 1 1 calc(16.66% - 10px); min-width: 130px;"
                             class="border rounded p-2 text-center bg-light">
                            <div class="font-weight-bold" style="font-size: 20px; color: #6c757d;">
                                <field name="count_closed" readonly="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">Cerradas</div>
                        </div>
                        <div style="flex: 1 1 calc(16.66% - 10px); min-width: 130px; background: #f8d7da;"
                             class="border rounded p-2 text-center">
                            <div class="font-weight-bold" style="font-size: 20px; color: #dc3545;">
                                <field name="count_overdue" readonly="1"/>
                            </div>
                            <div class="text-muted" style="font-size: 12px;">Vencidas (SLA)</div>
                        </div>
                    </div>

                    <!-- ── Alertas rápidas (3 tarjetas con botones) ── -->
                    <h4 class="mb-2">Alertas</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                        <div style="flex: 1 1 calc(33.33% - 12px); min-width: 200px;"
                             class="border rounded p-3 text-center">
                            <div class="font-weight-bold text-danger" style="font-size: 28px;">
                                <field name="count_critical" readonly="1"/>
                            </div>
                            <div class="mb-2">Órdenes Críticas Activas</div>
                            <button name="action_view_critical" type="object"
                                    class="btn btn-sm btn-danger"
                                    attrs="{'invisible': [('count_critical', '=', 0)]}">
                                Ver críticas
                            </button>
                        </div>
                        <div style="flex: 1 1 calc(33.33% - 12px); min-width: 200px;"
                             class="border rounded p-3 text-center">
                            <div class="font-weight-bold text-warning" style="font-size: 28px;">
                                <field name="count_unassigned" readonly="1"/>
                            </div>
                            <div class="mb-2">Sin Técnico Asignado</div>
                            <button name="action_view_unassigned" type="object"
                                    class="btn btn-sm btn-warning"
                                    attrs="{'invisible': [('count_unassigned', '=', 0)]}">
                                Asignar técnico
                            </button>
                        </div>
                        <div style="flex: 1 1 calc(33.33% - 12px); min-width: 200px;"
                             class="border rounded p-3 text-center">
                            <div class="font-weight-bold text-danger" style="font-size: 28px;">
                                <field name="count_overdue" readonly="1"/>
                            </div>
                            <div class="mb-2">Órdenes Vencidas</div>
                            <button name="action_view_overdue" type="object"
                                    class="btn btn-sm btn-danger"
                                    attrs="{'invisible': [('count_overdue', '=', 0)]}">
                                Revisar vencidas
                            </button>
                        </div>
                    </div>

                    <!-- ── Métricas de rendimiento (2 tarjetas) ── -->
                    <h4 class="mb-2">Métricas de Rendimiento</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                        <div style="flex: 1 1 calc(50% - 12px); min-width: 200px;"
                             class="border rounded p-3 text-center bg-light">
                            <div class="font-weight-bold text-info" style="font-size: 28px;">
                                <field name="avg_resolution_days" readonly="1"/>
                            </div>
                            <div>Días Promedio de Resolución</div>
                        </div>
                        <div style="flex: 1 1 calc(50% - 12px); min-width: 200px;"
                             class="border rounded p-3 text-center bg-light">
                            <div class="font-weight-bold text-secondary" style="font-size: 28px;">
                                <field name="recurrence_rate" readonly="1"/>%
                            </div>
                            <div>Tasa de Reincidencia</div>
                            <small class="text-muted">Objetivo: &lt; 10%</small>
                        </div>
                    </div>

                    <!-- ── ISO/IEC 25010 Métricas (RF-20) ── -->
                    <h4 class="mb-2">Indicadores ISO/IEC 25010</h4>
                    <field name="iso_correctness_semaphore" invisible="1"/>
                    <field name="iso_efficiency_semaphore" invisible="1"/>
                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                        <div style="flex: 1 1 calc(33.33% - 12px); min-width: 200px;"
                             class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Funcionalidad Correcta</strong>
                                <span>
                                    <span style="font-size: 20px;" attrs="{'invisible': [('iso_correctness_semaphore', '!=', 'green')]}">🟢</span>
                                    <span style="font-size: 20px;" attrs="{'invisible': [('iso_correctness_semaphore', '!=', 'yellow')]}">🟡</span>
                                    <span style="font-size: 20px;" attrs="{'invisible': [('iso_correctness_semaphore', '!=', 'red')]}">🔴</span>
                                </span>
                            </div>
                            <div class="text-center font-weight-bold" style="font-size: 24px;">
                                <field name="iso_correctness" readonly="1"/>%
                            </div>
                            <small class="text-muted">Órdenes sin reincidencia / Total cerradas</small>
                        </div>
                        <div style="flex: 1 1 calc(33.33% - 12px); min-width: 200px;"
                             class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Eficiencia de Rendimiento</strong>
                                <span>
                                    <span style="font-size: 20px;" attrs="{'invisible': [('iso_efficiency_semaphore', '!=', 'green')]}">🟢</span>
                                    <span style="font-size: 20px;" attrs="{'invisible': [('iso_efficiency_semaphore', '!=', 'yellow')]}">🟡</span>
                                    <span style="font-size: 20px;" attrs="{'invisible': [('iso_efficiency_semaphore', '!=', 'red')]}">🔴</span>
                                </span>
                            </div>
                            <div class="text-center font-weight-bold" style="font-size: 24px;">
                                <field name="iso_efficiency" readonly="1"/>%
                            </div>
                            <small class="text-muted">Órdenes resueltas dentro del SLA</small>
                        </div>
                        <div style="flex: 1 1 calc(33.33% - 12px); min-width: 200px;"
                             class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Disponibilidad del Servicio</strong>
                            </div>
                            <div class="text-center font-weight-bold" style="font-size: 20px;">
                                <field name="iso_availability" readonly="1"/>
                            </div>
                            <small class="text-muted">ISO 25010 — Reliability</small>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA GRÁFICA — Órdenes por Estado (RF-18)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_maintenance_order_graph" model="ir.ui.view">
        <field name="name">ts.maintenance.order.graph</field>
        <field name="model">ts.maintenance.order</field>
        <field name="arch" type="xml">
            <graph string="Órdenes por Estado" type="bar" sample="1">
                <field name="state" type="row"/>
                <field name="priority" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA PIVOT — Análisis de Órdenes (RF-18)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_maintenance_order_pivot" model="ir.ui.view">
        <field name="name">ts.maintenance.order.pivot</field>
        <field name="model">ts.maintenance.order</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Mantenimientos" sample="1">
                <field name="reception_date" type="row" interval="month"/>
                <field name="technician_id" type="col"/>
                <field name="days_open" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Acción Dashboard -->
    <record id="action_ts_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">ts.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
    </record>

    <!-- Acción análisis gráfico -->
    <record id="action_ts_order_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de Órdenes</field>
        <field name="res_model">ts.maintenance.order</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

</odoo>
