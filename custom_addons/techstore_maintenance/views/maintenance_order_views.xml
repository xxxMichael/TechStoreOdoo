<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA FORMULARIO — Orden de Mantenimiento
         Cubre: RF-01 (crear), RF-02 (técnico), RF-03 (estado), RF-04 (prioridad),
                RF-05 (diagnóstico), RF-06 (cierre), RF-13 (estado físico), RF-15 (log)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_maintenance_order_form" model="ir.ui.view">
        <field name="name">ts.maintenance.order.form</field>
        <field name="model">ts.maintenance.order</field>
        <field name="arch" type="xml">
            <form string="Orden de Mantenimiento">

                <header>
                    <button name="action_start_diagnosis"
                            string="Iniciar Diagnóstico"
                            type="object"
                            class="btn-primary"
                            icon="fa-search"
                            attrs="{'invisible': [('state', '!=', 'received')]}"/>
                    <button name="action_start_repair"
                            string="Iniciar Reparación"
                            type="object"
                            class="btn-primary"
                            icon="fa-wrench"
                            attrs="{'invisible': [('state', '!=', 'diagnosis')]}"/>
                    <button name="action_mark_ready"
                            string="Listo para Entrega"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"
                            attrs="{'invisible': [('state', '!=', 'repair')]}"/>
                    <button name="action_mark_delivered"
                            string="Marcar Entregado"
                            type="object"
                            class="btn-primary"
                            icon="fa-truck"
                            attrs="{'invisible': [('state', '!=', 'ready')]}"/>
                    <button name="action_close"
                            string="Cerrar Orden"
                            type="object"
                            class="btn-secondary"
                            icon="fa-lock"
                            attrs="{'invisible': [('state', '!=', 'delivered')]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,diagnosis,repair,ready,delivered,closed"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Cerrada" bg_color="bg-secondary"
                            attrs="{'invisible': [('state', '!=', 'closed')]}"/>
                    <widget name="web_ribbon" title="Reabierta" bg_color="bg-warning"
                            attrs="{'invisible': [('reopened', '=', False)]}"/>

                    <div class="alert alert-danger" role="alert"
                         attrs="{'invisible': [('priority', '!=', '3')]}">
                        <strong>PRIORIDAD CRÍTICA</strong> — Esta orden requiere atención inmediata.
                    </div>

                    <div class="oe_title">
                        <h1><field name="folio" readonly="1"/></h1>
                        <div class="o_row">
                            <field name="priority" widget="priority"
                                   attrs="{'readonly': [('state', '=', 'closed')]}"/>
                            <field name="state" widget="badge" readonly="1" class="oe_inline"
                                   decoration-info="state == 'received'"
                                   decoration-warning="state in ('diagnosis', 'repair')"
                                   decoration-success="state == 'ready'"
                                   decoration-primary="state == 'delivered'"
                                   decoration-muted="state == 'closed'"/>
                            <span class="oe_inline"> | Abierta: <field name="days_open" readonly="1" class="oe_inline"/> días</span>
                        </div>
                    </div>

                    <group>
                        <group string="Datos del Servicio">
                            <field name="client_id"
                                   attrs="{'readonly': [('state', '=', 'closed')]}"/>
                            <field name="equipment_id"
                                   attrs="{'readonly': [('state', '=', 'closed')]}"/>
                            <field name="service_type_id"
                                   attrs="{'readonly': [('state', '=', 'closed')]}"/>
                            <field name="reception_date"
                                   attrs="{'readonly': [('state', '=', 'closed')]}"/>
                        </group>
                        <group string="Asignación">
                            <field name="technician_id"
                                   attrs="{'readonly': [('state', '=', 'closed')]}"/>
                            <field name="delivery_date" readonly="1"
                                   attrs="{'invisible': [('delivery_date', '=', False)]}"/>
                            <field name="close_date" readonly="1"
                                   attrs="{'invisible': [('close_date', '=', False)]}"/>
                            <field name="reopened" readonly="1"
                                   attrs="{'invisible': [('reopened', '=', False)]}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Problema e Ingreso" name="problem">
                            <group>
                                <field name="problem_description"
                                       placeholder="Describe el problema reportado por el cliente..."
                                       attrs="{'readonly': [('state', '=', 'closed')]}"/>
                                <field name="physical_condition"
                                       string="Estado físico al ingreso"
                                       placeholder="Describe el estado físico del equipo al momento de la recepción: daños visibles, accesorios incluidos, etc."
                                       attrs="{'readonly': [('state', 'not in', ['received', 'diagnosis'])]}"/>
                            </group>
                        </page>

                        <page string="Diagnóstico y Solución" name="diagnosis"
                              attrs="{'invisible': [('state', 'in', ['received'])]}">
                            <group>
                                <field name="diagnosis"
                                       placeholder="Ingresa el diagnóstico técnico detallado..."
                                       attrs="{'readonly': [('state', 'in', ['ready', 'delivered', 'closed'])]}"/>
                                <field name="work_done"
                                       placeholder="Describe los trabajos realizados..."
                                       attrs="{'readonly': [('state', 'in', ['delivered', 'closed'])]}"/>
                                <field name="parts_used"
                                       placeholder="Lista los repuestos o materiales utilizados..."
                                       attrs="{'readonly': [('state', 'in', ['delivered', 'closed'])]}"/>
                                <field name="resolution"
                                       placeholder="Describe la solución aplicada al equipo..."
                                       attrs="{'readonly': [('state', 'in', ['delivered', 'closed'])]}"/>
                            </group>
                        </page>

                        <page string="Entrega" name="delivery"
                              attrs="{'invisible': [('state', 'not in', ['ready', 'delivered', 'closed'])]}">
                            <group>
                                <field name="delivery_confirmation"
                                       placeholder="Notas sobre la entrega al cliente..."
                                       attrs="{'readonly': [('state', '=', 'closed')]}"/>
                            </group>
                        </page>

                        <page string="Historial de Cambios" name="audit">
                            <field name="audit_log_ids" readonly="1">
                                <tree string="Log de Auditoría" create="false" edit="false" delete="false">
                                    <field name="event_date"/>
                                    <field name="user_id"/>
                                    <field name="event_type"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA LISTA — Órdenes de Mantenimiento
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_maintenance_order_list" model="ir.ui.view">
        <field name="name">ts.maintenance.order.list</field>
        <field name="model">ts.maintenance.order</field>
        <field name="arch" type="xml">
            <tree string="Órdenes de Mantenimiento"
                  decoration-danger="priority == '3' and state != 'closed'"
                  decoration-warning="priority == '2' and state != 'closed'"
                  decoration-info="state == 'received'"
                  decoration-success="state == 'ready'"
                  decoration-muted="state == 'closed'">
                <field name="folio"/>
                <field name="reception_date"/>
                <field name="client_id"/>
                <field name="equipment_id"/>
                <field name="service_type_id"/>
                <field name="technician_id"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'"
                       decoration-warning="state in ('diagnosis', 'repair')"
                       decoration-success="state == 'ready'"
                       decoration-primary="state == 'delivered'"
                       decoration-muted="state == 'closed'"/>
                <field name="days_open" string="Días"/>
                <field name="close_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="reopened" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA KANBAN — Tablero de Órdenes Activas (RF-14)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_maintenance_order_kanban" model="ir.ui.view">
        <field name="name">ts.maintenance.order.kanban</field>
        <field name="model">ts.maintenance.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    group_create="false"
                    quick_create="false"
                    class="o_kanban_small_column">
                <field name="folio"/>
                <field name="client_id"/>
                <field name="equipment_id"/>
                <field name="service_type_id"/>
                <field name="technician_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="days_open"/>
                <field name="priority_kanban"/>
                <templates>
                    <t t-name="kanban-box">
                        <t t-set="state_class"
                           t-value="record.state.raw_value == 'received' and 'border-info' or
                                    record.state.raw_value == 'diagnosis' and 'border-warning' or
                                    record.state.raw_value == 'repair' and 'border-info' or
                                    record.state.raw_value == 'ready' and 'border-success' or
                                    record.state.raw_value == 'delivered' and 'border-primary' or
                                    record.state.raw_value == 'closed' and 'border-secondary' or ''"/>
                        <t t-set="priority_class"
                           t-value="record.priority.raw_value == '3' and 'border-danger' or
                                    record.priority.raw_value == '2' and 'border-warning' or ''"/>
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{priority_class}" style="border-left: 5px solid inherit;">
                            <div class="oe_kanban_content p-2">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <strong class="text-truncate" style="font-size: 14px;">
                                        <field name="folio"/>
                                    </strong>
                                    <span t-attf-class="badge badge-pill
                                        #{record.state.raw_value == 'received' and 'badge-info' or ''}
                                        #{record.state.raw_value == 'diagnosis' and 'badge-warning' or ''}
                                        #{record.state.raw_value == 'repair' and 'badge-info' or ''}
                                        #{record.state.raw_value == 'ready' and 'badge-success' or ''}
                                        #{record.state.raw_value == 'delivered' and 'badge-primary' or ''}
                                        #{record.state.raw_value == 'closed' and 'badge-secondary' or ''}"
                                        style="font-size: 10px;">
                                        <t t-esc="record.state.value"/>
                                    </span>
                                </div>
                                <div style="display: flex; align-items: center; margin-bottom: 4px;
                                            background: #f8f9fa; border-radius: 4px; padding: 4px 6px;">
                                    <i class="fa fa-star mr-2" style="color: #ffc107; font-size: 12px;"/>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div style="margin-bottom: 3px; font-size: 12px; color: #495057;">
                                    <i class="fa fa-user mr-1" style="width: 14px; text-align: center;"/> <field name="client_id"/>
                                </div>
                                <div style="margin-bottom: 3px; font-size: 12px; color: #495057;">
                                    <i class="fa fa-laptop mr-1" style="width: 14px; text-align: center;"/> <field name="equipment_id"/>
                                </div>
                                <div style="font-size: 12px; color: #495057;">
                                    <i class="fa fa-wrench mr-1" style="width: 14px; text-align: center;"/> <field name="service_type_id"/>
                                </div>
                            </div>
                            <div style="background: #f8f9fa; display: flex; justify-content: space-between;
                                        align-items: center; padding: 6px 10px; border-top: 1px solid #eee;
                                        font-size: 11px; color: #6c757d;">
                                <span>
                                    <i class="fa fa-clock-o mr-1"/>
                                    <field name="days_open"/> días
                                </span>
                                <field name="technician_id" widget="many2one_avatar"
                                       options="{'no_open': True}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FILTROS Y BÚSQUEDA — RF-17
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_ts_maintenance_order_search" model="ir.ui.view">
        <field name="name">ts.maintenance.order.search</field>
        <field name="model">ts.maintenance.order</field>
        <field name="arch" type="xml">
            <search string="Buscar Órdenes">
                <field name="folio" string="Folio"/>
                <field name="client_id" string="Cliente"/>
                <field name="technician_id" string="Técnico"/>
                <field name="equipment_id" string="Equipo"/>
                <field name="service_type_id" string="Tipo de servicio"/>
                <separator/>
                <filter name="filter_active"
                        string="Activas"
                        domain="[('state', 'not in', ['closed'])]"/>
                <filter name="filter_critical"
                        string="Críticas"
                        domain="[('priority', '=', '3')]"/>
                <filter name="filter_high"
                        string="Alta prioridad"
                        domain="[('priority', 'in', ['2', '3'])]"/>
                <separator/>
                <filter name="filter_received"
                        string="Recibidas"
                        domain="[('state', '=', 'received')]"/>
                <filter name="filter_diagnosis"
                        string="En Diagnóstico"
                        domain="[('state', '=', 'diagnosis')]"/>
                <filter name="filter_repair"
                        string="En Reparación"
                        domain="[('state', '=', 'repair')]"/>
                <filter name="filter_ready"
                        string="Listas para Entrega"
                        domain="[('state', '=', 'ready')]"/>
                <filter name="filter_closed"
                        string="Cerradas"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_unassigned"
                        string="Sin técnico asignado"
                        domain="[('technician_id', '=', False)]"/>
                <filter name="filter_reopened"
                        string="Reabiertas"
                        domain="[('reopened', '=', True)]"/>
                <filter name="filter_today"
                        string="Recibidas hoy"
                        domain="[('reception_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state"   string="Estado"    context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Prioridad" context="{'group_by': 'priority'}"/>
                    <filter name="group_technician" string="Técnico" context="{'group_by': 'technician_id'}"/>
                    <filter name="group_client"   string="Cliente"   context="{'group_by': 'client_id'}"/>
                    <filter name="group_service"  string="Tipo de servicio" context="{'group_by': 'service_type_id'}"/>
                    <filter name="group_date"     string="Fecha de recepción" context="{'group_by': 'reception_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         ACCIÓN DE VENTANA — Órdenes de Mantenimiento
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_ts_maintenance_order" model="ir.actions.act_window">
        <field name="name">Órdenes de Mantenimiento</field>
        <field name="res_model">ts.maintenance.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay órdenes de mantenimiento activas.
            </p>
            <p>Crea la primera orden de mantenimiento para comenzar.</p>
        </field>
    </record>

</odoo>
