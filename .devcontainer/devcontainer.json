{
  "name": "TechStore Odoo 16 - Dev Container",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "odoo",
  "workspaceFolder": "/mnt/extra-addons",
  "extensions": [
    "ms-python.python",
    "ms-python.pylint",
    "odoo-ide.odoo-dev-tools",
    "ms-azuretools.vscode-docker"
  ],
  "settings": {
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true
  },
  "forwardPorts": [8069],
  "postCreateCommand": "echo 'Dev container listo para TechStore Maintenance'"
}
